# AGENTBANK Environment Configuration

# Private key for deployment and transactions (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs (get from Alchemy or Infura)
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Block explorers API keys for contract verification
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# For testing
ENABLE_FORKING=false
